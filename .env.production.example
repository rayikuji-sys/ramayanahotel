# Replace BOTH addresses with the same real HTTPS website origin.
APP_URL=https://hotel.example.com
HOTEL_WEBSITE_URL=https://hotel.example.com
COOKIE_SECURE=true
TRUST_PROXY=false
PUBLIC_SITE=false
BOOKING_MODE=sandbox
BOOKING_EMAIL_ENABLED=false
BOOKING_EMAIL_AUTOSEND=false
# Optional SMTP credentials belong in the hosting secret store, never Git.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
