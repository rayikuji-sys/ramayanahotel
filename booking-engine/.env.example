BOOKING_PORT=3003
BOOKING_MODE=sandbox
BOOKING_DB=data/booking-sandbox.sqlite
# This release refuses live payments. Email defaults to private previews only.
# Future provider configuration (not active in this release):
MIDTRANS_SERVER_KEY=
BOOKING_PUBLIC_URL=http://127.0.0.1:3003
# Optional SMTP: explicit staff dispatch only; old previews are never auto-sent.
BOOKING_EMAIL_ENABLED=false
# Opt-in automatic transactional email for NEW booking events only.
# Historical previews never enter the automatic queue when this flag changes.
BOOKING_EMAIL_AUTOSEND=false
BOOKING_HOTEL_EMAIL=ramayanahotelmksr@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
