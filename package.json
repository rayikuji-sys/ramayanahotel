{
  "name": "ramayana-hotel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-hotel.mjs dev",
    "build": "next build --webpack",
    "start": "node scripts/run-hotel.mjs start",
    "lint": "eslint app components/hotel lib tests",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/backend.test.ts tests/events.test.ts tests/planner.test.ts",
    "test:e2e": "playwright test",
    "test:booking": "npm --prefix booking-engine test",
    "test:booking-integration": "node --experimental-strip-types scripts/booking-integration-smoke.mjs",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "admin:create": "node --experimental-strip-types scripts/create-admin.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.19",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "typescript": "5.9.3"
  }
}
