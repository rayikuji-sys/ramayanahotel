APP_URL=http://localhost:3001
HOTEL_PORT=3001
HOTEL_WEBSITE_URL=http://localhost:3001
PUBLIC_SITE=false
BOOKING_PORT=3003
BOOKING_MODE=sandbox
# Relative to booking-engine/, not the repository root.
BOOKING_DB=data/booking-sandbox.sqlite
BOOKING_EMAIL_ENABLED=false
BOOKING_EMAIL_AUTOSEND=false
BOOKING_HOTEL_EMAIL=ramayanahotelmksr@gmail.com
# Load this file into BOTH services using Node --env-file (see README).
# Leave BOOKING_ENGINE_URL unset to keep all reservations on /booking.
# BOOKING_ENGINE_URL=https://your-separate-booking-domain.example/
# Internal server URL, never exposed to guests. npm run dev/start sets this automatically.
# BOOKING_INTERNAL_URL=http://127.0.0.1:3003
HOTEL_DB_PATH=data/hotel.db
COOKIE_SECURE=false
TRUST_PROXY=false
# Set these only for the admin:create command. Never commit real credentials.
ADMIN_EMAIL=admin@ramayana.local
# ADMIN_PASSWORD=use-a-unique-password-at-least-14-characters
# Event notifications go to ramayanahotelmksr@gmail.com and the guest's email.
# Configure on the server in .env.local; never commit real credentials.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-sending-account@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Ramayana Hotel <your-sending-account@gmail.com>
# Use the public HTTPS website address for APP_URL when deployed.
